<Window x:Class="AnnuaireEntreprise.Views.AdminLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Accès Administrateur" Height="200" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="🔐 Mot de passe administrateur" 
                   FontWeight="Bold" Margin="0,0,0,15"/>
        <PasswordBox x:Name="TxtPassword" Margin="0,0,0,10"/>
        <Button Content="Connexion" Click="BtnConnexion_Click"
                Background="#600000" Foreground="White" Padding="10,5"/>
        <TextBlock x:Name="TxtErreur" Foreground="Red" 
                   Margin="0,8,0,0" Visibility="Collapsed"/>
    </StackPanel>
</Window>