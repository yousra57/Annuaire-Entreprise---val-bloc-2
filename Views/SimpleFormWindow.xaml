<Window x:Class="AnnuaireEntreprise.Views.SimpleFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="160" Width="320" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock x:Name="TxtLabel" Margin="0,0,0,8" FontWeight="Bold"/>
        <TextBox x:Name="TxtValeur" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Valider" Click="BtnValider_Click"
                    Background="#27AE60" Foreground="White"
                    Padding="12,5" Margin="0,0,5,0" BorderThickness="0"/>
            <Button Content="Annuler" Click="BtnAnnuler_Click"
                    Padding="12,5" BorderThickness="0"/>
        </StackPanel>
    </StackPanel>
</Window>