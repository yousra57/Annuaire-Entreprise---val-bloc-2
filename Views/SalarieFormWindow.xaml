<Window x:Class="AnnuaireEntreprise.Views.SalarieFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="420" Width="380" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="Nom :" Margin="0,5,0,3"/>
        <TextBox x:Name="TxtNom"/>
        <TextBlock Text="Prénom :" Margin="0,8,0,3"/>
        <TextBox x:Name="TxtPrenom"/>
        <TextBlock Text="Email :" Margin="0,8,0,3"/>
        <TextBox x:Name="TxtEmail"/>
        <TextBlock Text="Téléphone fixe :" Margin="0,8,0,3"/>
        <TextBox x:Name="TxtTelFixe"/>
        <TextBlock Text="Téléphone portable :" Margin="0,8,0,3"/>
        <TextBox x:Name="TxtTelPortable"/>
        <TextBlock Text="Site :" Margin="0,8,0,3"/>
        <ComboBox x:Name="CbSite" DisplayMemberPath="Ville"/>
        <TextBlock Text="Service :" Margin="0,8,0,3"/>
        <ComboBox x:Name="CbService" DisplayMemberPath="Nom"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Valider" Click="BtnValider_Click"
                    Background="#27AE60" Foreground="White"
                    Padding="12,5" Margin="0,0,5,0" BorderThickness="0"/>
            <Button Content="Annuler" Click="BtnAnnuler_Click"
                    Padding="12,5" BorderThickness="0"/>
        </StackPanel>
    </StackPanel>
</Window>