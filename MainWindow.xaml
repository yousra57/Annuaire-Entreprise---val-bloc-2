<Window x:Class="AnnuaireEntreprise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Annuaire Entreprise" Height="600" Width="900"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#600000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#600000" Padding="20,15">
            <TextBlock Text="📋 Annuaire Entreprise" 
                       Foreground="White" FontSize="22" FontWeight="Bold"/>
        </Border>

        <!-- Filtres de recherche -->
        <Border DockPanel.Dock="Top" Background="#ECF0F1" Padding="15">
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                    <TextBlock Text="Nom :" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtRecherche" Width="180" 
                             TextChanged="TxtRecherche_TextChanged"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                    <TextBlock Text="Site :" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CbSite" Width="130" 
                              SelectionChanged="Filtre_Changed"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                    <TextBlock Text="Service :" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CbService" Width="130" 
                              SelectionChanged="Filtre_Changed"/>
                </StackPanel>

                <Button Content="Réinitialiser" Click="BtnReset_Click" Margin="5,0,0,0"/>
            </WrapPanel>
        </Border>

        <!-- Contenu principal -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Liste des salariés -->
            <Border Grid.Column="0" Margin="10">
                <DataGrid x:Name="DgSalaries"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionChanged="DgSalaries_SelectionChanged"
                          RowBackground="White"
                          AlternatingRowBackground="#F8F9FA"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="120"/>
                        <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" Width="120"/>
                        <DataGridTextColumn Header="Service" Binding="{Binding Service.Nom}" Width="120"/>
                        <DataGridTextColumn Header="Site" Binding="{Binding Site.Ville}" Width="100"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Fiche détaillée -->
            <Border Grid.Column="1" Margin="0,10,10,10" 
                    Background="#F8F9FA" CornerRadius="8"
                    BorderBrush="#BDC3C7" BorderThickness="1">
                <StackPanel Margin="15" x:Name="PanelFiche">
                    <TextBlock Text="Fiche Salarié" FontSize="16" 
                               FontWeight="Bold" Margin="0,0,0,15"
                               Foreground="#600000"/>

                    <TextBlock Text="Sélectionnez un salarié" 
                               x:Name="TxtAucuneSel"
                               Foreground="#95A5A6" FontStyle="Italic"/>

                    <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                        <Border Background="#600000" CornerRadius="50" 
                                Width="60" Height="60" Margin="0,0,0,15"
                                HorizontalAlignment="Left">
                            <TextBlock x:Name="TxtInitiales" 
                                       Foreground="White" FontSize="22"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock x:Name="TxtNomComplet" FontSize="16" 
                                   FontWeight="Bold" Margin="0,0,0,10"/>

                        <Separator Margin="0,5,0,10"/>

                        <StackPanel Margin="0,4">
                            <TextBlock Text="📧 Email" Foreground="#7F8C8D" FontSize="11"/>
                            <TextBlock x:Name="TxtEmail" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Margin="0,4">
                            <TextBlock Text="📞 Téléphone fixe" Foreground="#7F8C8D" FontSize="11"/>
                            <TextBlock x:Name="TxtTelFixe" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Margin="0,4">
                            <TextBlock Text="📱 Téléphone portable" Foreground="#7F8C8D" FontSize="11"/>
                            <TextBlock x:Name="TxtTelPortable" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Margin="0,4">
                            <TextBlock Text="🏢 Service" Foreground="#7F8C8D" FontSize="11"/>
                            <TextBlock x:Name="TxtService" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Margin="0,4">
                            <TextBlock Text="📍 Site" Foreground="#7F8C8D" FontSize="11"/>
                            <TextBlock x:Name="TxtSite" FontSize="13"/>
                        </StackPanel>

                        <Button Content=" Exporter en PDF 📄" 
                                Click="BtnExportPdf_Click"
                                Margin="0,15,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>